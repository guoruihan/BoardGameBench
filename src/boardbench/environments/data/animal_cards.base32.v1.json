      "commit": "a5ffa20f4d6206632eec2c83e93c39cff79283c8"
    },
    {
      "id": "independent_score_catalog",
      "url": "https://github.com/ducktapegirl/game-scorer/tree/47c5b7032e5b6404d6d7a2ed9c5c45a76ba5f076",
      "commit": "47c5b7032e5b6404d6d7a2ed9c5c45a76ba5f076",
      "role": "second-repository English labels and cumulative score cross-check for all 32 animals; this does not independently verify spatial patterns"
    }
  ],
  "coordinate_convention": {
    "type": "axial",
    "distance": "max(abs(dq),abs(dr),abs(dq+dr))",
    "anchor": [
      0,
      0
    ],
    "source_direction_deltas": [
      [
        1,
        0
      ],
      [
        1,
        -1
      ],
      [
        0,
        -1
      ],
      [
        -1,
        0
      ],
      [
        -1,
        1
      ],
      [
        0,
        1
      ]
    ],
    "source_pattern_semantics": "The first source position is ignored. Each later position is a direction from the previous pattern cell. colors are top-to-bottom. After chain expansion, subtract the unique allowCube position from every cell.",
    "rotations": "Six rotations. One valid 60-degree transform is (q,r) -> (-r,q+r). Deduplicate geometrically identical placements."
  },
  "matching_rules": {
    "anchor_must_have_no_cube": true,
    "non_anchor_cells_may_have_cubes": true,
    "exact_heights_required": true,
    "building_pattern_requires_height": 2,
    "building_pattern_requires_landscape_score_eligibility": false,
    "animal_cube_placement_is_persistent": true,
    "score_rule": "score_by_placed_count[k] is cumulative score after k cubes placed, not a sum of revealed values."
  },
